      ],
      "status": "implemented: manual release opens physical ward seal"
    },
    {
      "id": "ContainmentEvidence",
      "title": "Examine the containment evidence",
      "position": [
        600,
        414
      ],
      "kind": "note",
      "objective": "Examine the containment evidence",
      "lines": [
        [
          "OBSERVATION LOG \u2014 DRAFT",
          "Symptoms appeared among staff after an isolation failure.\nThe cases were logged before the present unrest."
        ],
        [
          "MIRO",
          "The illness is real. That does not excuse this room."
        ]
      ],
      "requires": [],
      "status": "draft evidence; exact illness remains open"
    },
    {
      "id": "BrotherWarning",
      "title": "Hear the warning about the ward",
      "position": [
        410,
        414
      ],
      "kind": "brother",
      "objective": "Hear the warning about the ward",
      "lines": [
        [
          "BROTHER",
          "You saw the isolation records. This place has hurt people.\nIt may also be holding something back."
        ],
        [
          "MIRO",
          "And how many people are we allowed to hurt to keep it?"
        ]
      ],
      "requires": [
        "ExperimentRecords",
        "ContainmentEvidence"
      ],
      "status": "draft story"
    },
