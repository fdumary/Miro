  "number": 4,
  "opening": "Sealed rooms. Observation windows. No names on the charts.\nWhatever happened here was deliberate.",
  "closing": "Cruelty is evident. So is the danger outside containment.",
  "stations": [
    {
      "id": "ExperimentRecords",
      "title": "Inspect the experiment records",
      "position": [
        300,
        230
      ],
      "kind": "note",
      "objective": "Inspect the experiment records",
      "lines": [
        [
          "WARD RECORD",
          "Restraints maintained after consent withdrawn.\nTrial continued despite deterioration."
        ],
        [
          "MIRO",
          "They wrote it down as if that made it acceptable."
        ]
      ],
      "requires": [],
      "status": "draft story"
    },
    {
      "id": "WardRelease",
      "title": "Release the ward seal",
      "position": [
