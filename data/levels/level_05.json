  "number": 5,
  "opening": "At the bottom, everything else rests on what they keep here.",
  "closing": "Miro leaves alone. The ending stays unresolved.",
  "stations": [
    {
      "id": "Guitar",
      "title": "Pick up the guitar",
      "position": [
        190,
        230
      ],
      "kind": "note",
      "objective": "Pick up the guitar",
      "lines": [
        [
          "MIRO",
          "A guitar on a stand, strings still in tune.\nMine. He kept it."
        ],
        [
          "MIRO",
          "My fingers already know where to go."
        ]
      ],
      "requires": [],
      "status": "implemented: starts Shit Crashed, alarm, wave 1"
    },
    {
      "id": "FinalSigil",
      "title": "Place the final sigil",
      "position": [
        300,
        230
      ],
      "kind": "sigil",
      "objective": "Place the final sigil",
      "lines": [
        [
          "MIRO",
          "The last support. The last mark."
        ]
      ],
      "requires": [],
      "status": "draft story"
    },
    {
      "id": "FinalOffer",
      "title": "Face Niro",
      "position": [
        570,
        226
      ],
      "kind": "brother",
      "objective": "Face Niro",
      "lines": [
        [
          "NIRO",
          "Put it down, Miro. You were never supposed to wake up this far down."
        ],
        [
          "MIRO",
          "You. The voice in the remote. Niro."
        ],
        [
          "NIRO",
          "You were never sick. Exposure after exposure, nothing.\nYou are immune, Miro. You always were."
        ],
        [
          "NIRO",
          "The tower made the sickness. They called it progress.\nWhen it got out, they told me you were our only chance."
        ],
        [
          "MIRO",
          "So you locked me up to take me apart."
        ],
        [
          "NIRO",
          "I kept you alive. I thought if I understood why, I could save everyone.\nThey said you'd destroy the cure if you got out. I believed them."
        ],
        [
          "MIRO",
          "You let me believe I was dangerous."
        ],
        [
          "NIRO",
          "I believed keeping you here was love."
        ],
        [
          "MIRO",
          "You do not get to call it love and lock the door."
        ]
      ],
      "requires": [
        "Guitar"
      ],
      "status": "automatic: Niro's first appearance after wave 1"
    },
    {
      "id": "BrotherEncounter",
      "title": "Face Niro",
      "position": [
        560,
        846
      ],
      "kind": "brother",
      "objective": "Face Niro",
      "lines": [
        [
          "NIRO",
          "Stay. Help me finish it. If all of this was for nothing...\nI do not know who I have been."
        ],
        [
          "MIRO",
          "Then find out."
        ],
        [
          "NIRO",
          "Then come, brother."
        ]
      ],
      "requires": [
        "FinalOffer"
      ],
      "status": "automatic: final fight on the deepest floor"
    },
    {
      "id": "DefeatExchange",
      "title": "Listen to your brother",
      "position": [
        430,
        846
      ],
      "kind": "note",
      "objective": "Listen to your brother",
      "lines": [
        [
          "NIRO",
          "The sick are still real. Whatever the tower did...\ndo not forget them."
        ],
        [
          "NIRO",
          "I wanted a life where I could keep you safe.\nThey gave me a title, and I mistook it for a choice."
        ],
        [
          "MIRO",
          "Then choose now. Come with me."
        ],
        [
          "NIRO",
          "(He looks at the lab, not at Miro.)\nSomeone has to stay with them. Go."
        ],
        [
          "NIRO",
          "You are still my brother."
        ]
      ],
      "requires": [
        "BrotherEncounter"
      ],
      "status": "defeat exchange: Niro survives"
    },
    {
      "id": "ForestViewpoint",
      "title": "Reach the forest viewpoint",
      "position": [
        880,
        846
      ],
      "kind": "note",
      "objective": "Reach the forest viewpoint",
      "lines": [
        [
          "MIRO",
          "The woods. Air that does not belong to them."
        ]
      ],
      "requires": [
        "DefeatExchange"
      ],
      "status": "implemented: in-engine ending, pause and skip parity"
    }
